{
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "${env:LOCALAPPDATA}\\dotnet-sdk;${env:PATH}",
            "DOTNET_ROOT": "${env:LOCALAPPDATA}\\dotnet-sdk"
        }
    },
    "tasks": [
        {
            "label": "build-debug-x64",
            "type": "shell",
            "command": "dotnet build '${workspaceFolder}\\DTXMania.sln' -c Debug -p:Platform=x64 -v:minimal",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "build-release-x64",
            "type": "shell",
            "command": "dotnet build '${workspaceFolder}\\DTXMania.sln' -c Release -p:Platform=x64 -v:minimal",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "dotnet clean '${workspaceFolder}\\DTXMania.sln' -c Debug -p:Platform=x64 -v:minimal",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "restore",
            "type": "shell",
            "command": "dotnet restore '${workspaceFolder}\\DTXMania.sln'",
            "problemMatcher": []
        }
    ]
}
