<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>FDK</RootNamespace>
    <AssemblyName>FDK</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>0219</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>TRACE;TEST_CancelEnterCodeInAltEnter2 TEST_Direct3D9Ex_</DefineConstants>
    <!-- FDK never had DEBUG defined; dead code in #if DEBUG blocks references renamed types -->
    <DefineDebug>false</DefineDebug>
  </PropertyGroup>

  <!-- File that was never compiled in the old project -->
  <ItemGroup>
    <Compile Remove="Code\00.Common\CCpuCores.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE;TEST_ENGLISH_ TEST_Direct3D9Ex_</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectSound" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bass.Net">
      <HintPath>..\Runtime\dll\Bass.Net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DirectShowLib-2005">
      <HintPath>..\Runtime\dll\DirectShowLib-2005.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libraries\libbjxa\libbjxa.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Preserve legacy manifest resource name (SampleFramework.Properties.Resources) -->
  <ItemGroup>
    <EmbeddedResource Update="Code\01.Framework\Properties\Resources.resx">
      <DependentUpon>Resources.Designer.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyToRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SolutionDir)Runtime\dll" />
  </Target>
</Project>
